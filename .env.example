# PLANTILLA SIN SECRETOS. No es un archivo .env real.
# El backend lee os.environ; este archivo no se carga automáticamente.
# En Colab usar Secretos + la celda protegida de configuración.
# En Streamlit local/nube usar variables del proceso o .streamlit/secrets.toml.
# Modo propio: no lee ni reutiliza las credenciales del compañero.
RAG_QDRANT_DESTINO=propio
QDRANT_PROPIO_URL=
QDRANT_PROPIO_API_KEY=
# Colección propia fija: superstore_rag_docs_aca2_propio.
# Solo para consultar explícitamente el despliegue histórico:
# RAG_QDRANT_DESTINO=heredado
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=superstore_rag_docs
# Dejar vacío hasta auditar la versión remota y su índice de payload.
# La edición editorial 1.0.0 NO es la versión almacenada en Qdrant.
RAG_CORPUS_VERSION=
# Completar con el commit real de modelo_revision del manifiesto reconstruido.
# El Colab lo fija automáticamente después de validar los embeddings en 4A.
RAG_EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42

# Ruta principal dentro de Colab: autenticación administrada por su SDK.
RAG_LLM_BACKEND=colab_ai
GEMINI_MODEL=google/gemini-3.8-flash

# Ruta opcional fuera de Colab: cambiar backend/modelo y configurar API key.
# RAG_LLM_BACKEND=gemini_api
# GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

# Solo aplicados por Gemini REST, NO por la interfaz Colab AI utilizada.
RAG_TEMPERATURE=0
RAG_MAX_OUTPUT_TOKENS=1536
# Timeout de Qdrant/REST; Colab AI no expone timeout generativo configurable.
RAG_TIMEOUT_S=60
